# Секретный ключ в hex: dd… — обычный, ee… — fake TLS (как сейчас на mtproto.ru).
# Простой вариант сгенерировать — openssl rand -hex 16. Смена секрета меняет ссылку tg://
PROXY_SECRET=dd000102030405060708090a0b0c0d0e0f

# Порт (можно оставить 443 или изменить)
PROXY_PORT=443

# Тег образа: latest или 2.0beta
PROXY_TAG=latest
